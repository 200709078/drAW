{
  "name": "draw",
  "productName": "drAW",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "electron/main.ts",
  "description": "drAW - Interactive whiteboard and drawing application",
  "license": "MIT",
  "author": {
    "name": "Adem Varol",
    "email": "ademvarol0808@gmail.com",
    "url": "https://www.madematik.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron": "electron electron/main.ts",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "basic-ftp": "^6.0.2",
    "concurrently": "^10.0.4",
    "dotenv": "^17.4.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "build": {
    "appId": "com.madematik.draw",
    "productName": "drAW",
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "compression": "maximum",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "electron/assets/app-icons",
      "category": "Graphics",
      "executableName": "drAW"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/assets/app-icons/draw.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "drAW"
    },
    "mac": {
      "target": "dmg",
      "icon": "electron/assets/app-icons/draw.icns",
      "category": "public.app-category.education"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0"
  }
}
