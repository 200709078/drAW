{
  "name": "draw",
  "productName": "drAW",
  "desktopName": "drAW",
  "homepage": "https://www.madematik.com",
  "private": true,
  "version": "0.0.4",
  "type": "module",
  "main": "electron/main.ts",
  "description": "drAW - Interactive whiteboard and drawing application",
  "license": "MIT",
  "author": "mADEMatik <madematik@madematik.com> (https://www.madematik.com)",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc && tsc -p tsconfig.electron.json",
    "build": "npm run typecheck && node scripts/build-preloads.mjs && vite build",
    "test": "node --test tests/*.test.cjs",
    "preview": "vite preview",
    "electron": "electron electron/main.ts",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "basic-ftp": "^6.0.2",
    "concurrently": "^10.0.4",
    "dotenv": "^17.4.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "build": {
    "appId": "com.madematik.draw",
    "productName": "drAW",
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${os}-${arch}.${ext}",
    "compression": "maximum",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "syncDesktopName": true,
      "icon": "electron/assets/app-icons",
      "category": "Education",
      "executableName": "drAW",
      "synopsis": "Interactive whiteboard and drawing application",
      "desktop": {
        "entry": {
          "Comment[tr]": "Etkileşimli tahta ve çizim uygulaması"
        }
      }
    },
    "deb": {
      "packageCategory": "education"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/assets/app-icons/draw.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "drAW"
    },
    "mac": {
      "target": "dmg",
      "icon": "electron/assets/app-icons/draw.icns",
      "category": "public.app-category.education"
    }
  },
  "dependencies": {},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/200709078/drAW.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/200709078/drAW/issues"
  }
}
